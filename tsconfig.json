{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "ES2020",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "baseUrl": "src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "typescript-plugin-css-modules",
      }
    ],

    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
    }
  },
  "include": [
    "./config/jest/setupTests.ts",
    "src",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "./src/app/types/custom.d.ts"
  ]
}
